    "GlobalReset":"
        var sys_bar = 2;
        var sys_reg = 0x5000;
        
        log.info(\"Started Global Reset Procedure\");
        log.info(\"Bar: \" + sys_bar + \", register: 0x\" + sys_reg.toString(16).toUpperCase());
        
        var value = hw.read32(sys_bar, sys_reg);
        log.info(\"Initial value: 0x\" + value.toString(16).toUpperCase());
        
        log.info(\"Setting bit 0\");
        value |= 1;
        hw.write32(sys_bar, sys_reg, value);
        
        log.info(\"Clearing bit 0\");
        value &= ~1;
        hw.write32(sys_bar, sys_reg, value);
        
        log.info(\"Finished Global Reset Procedure\");
    "
}
